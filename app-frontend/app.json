{
  "expo": {
    "name": "Tanauan Water App",
    "slug": "app-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "appfrontend",
      "com.googleusercontent.apps.822086134232-t3lq8dg9mfe36qv4skce5c2i06rotdk6",
      "com.googleusercontent.apps.822086134232-6ah64287ciekqrpcsvfte1pl711q6l29"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.app-frontend",
      "appleTeamId": "WHRX53MMJM"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.appfrontend",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/twa-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/twa-splash.png",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "TWD connects to the PT-210 thermal printer over Bluetooth to print receipts at the meter."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5fc3ab67-58eb-4b7f-8b3b-c4aa34dc596e"
      }
    }
  }
}
